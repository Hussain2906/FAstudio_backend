PORT=4000
NODE_ENV=development
# Set true only when the API is reachable exclusively through one trusted reverse proxy (e.g. Caddy).
TRUST_PROXY=false
# Set true only for public requests entering through Railway's sanitizing HTTP edge.
TRUST_RAILWAY_REAL_IP=false
DATABASE_URL="NEON_POOLED_CONNECTION_URL"
DIRECT_URL="NEON_DIRECT_CONNECTION_URL"
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
SWAGGER_ENABLED=true
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_FOLDER=interior-portfolio/
CLOUDINARY_MAX_UPLOAD_BYTES=10485760
AUTH_SESSION_TTL_SECONDS=28800
AUTH_SESSION_COOKIE_NAME=fs_admin_session
AUTH_DIAGNOSTICS_ENABLED=false
# Optional for local startup; required before SMTP credentials can be saved or used.
# Generate a private 32-byte key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep the real value in the backend environment only; never commit it.
CONTACT_SMTP_ENCRYPTION_KEY=
