    "prestart:dev": "pnpm prisma:generate && pnpm generate:contracts",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --runInBand --config ./jest.e2e.config.cjs",
    "admin:create": "pnpm build && node scripts/create-admin.mjs",
    "admin:reset-password": "pnpm build && node scripts/reset-super-admin.mjs",
